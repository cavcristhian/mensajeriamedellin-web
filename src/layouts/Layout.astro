---
import "../styles/global.css";
import WhatsAppButton from "../components/WhatsAppButton.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    waMessage?: string;
    waButtonText?: string;
}

const {
    title,
    description = "Soluciones logísticas para empresas y e-commerce en Medellín. Mensajería, entregas express y domicilios con recaudo. Rápido y seguro.",
    image,
    waMessage,
    waButtonText,
} = Astro.props;

// Use provided image or fallback to a default if available, otherwise undefined
const socialImage =
    image || (Astro.site ? new URL("/logo.png", Astro.site) : "/logo.png");

// Normalize path to ALWAYS include trailing slash for canonical URL
const path = Astro.url.pathname.replace(/\/$/, "") + "/";
const canonicalURL = new URL(path, Astro.site);
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <!-- Google Analytics -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-HCRSS9W804"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-HCRSS9W804");
            gtag("config", "AW-17948061968");

            // Tracking inteligente de clics en WhatsApp
            document.addEventListener("click", (e) => {
                const target = e.target.closest("a");
                if (target && target.href && target.href.includes("wa.me")) {
                    const path = window.location.pathname;

                    // 1. Registro universal en Analytics para todos los clics de WhatsApp
                    gtag("event", "whatsapp_click", {
                        page_path: path,
                        button_id: target.id || "no-id",
                    });

                    // 2. SOLO contar como CONVERSIÓN si el cliente está en Home o Mandados
                    // (Evitamos que los que buscan empleo cuenten como venta)
                    if (path === "/" || path.includes("/mandados")) {
                        // Evento para Google Analytics
                        gtag("event", "generate_lead", {
                            event_category: "engagement",
                            event_label: "Client Lead",
                            value: 1,
                        });

                        // Conversión específica de Google Ads
                        gtag("event", "conversion", {
                            send_to: "AW-17948061968/Rq1oCOrxiPcbEJDipu5C",
                        });
                    } else if (path.includes("/empleo")) {
                        // Evento específico para recursos humanos (No es conversión de venta)
                        gtag("event", "empleo_contact", {
                            event_category: "engagement",
                            event_label: "Postulación Mensajero",
                        });
                    }
                }
            });
        </script>
        <!-- Favicon para Google Search (mínimo 48x48, múltiplos de 48 recomendados) -->
        <link
            rel="icon"
            type="image/png"
            sizes="48x48"
            href="https://mensajeriamedellin.com/favicon-48x48.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="192x192"
            href="https://mensajeriamedellin.com/android-chrome-192x192.png"
        />
        <!-- Favicon .ico para navegadores legacy -->
        <link
            rel="icon"
            href="https://mensajeriamedellin.com/favicon.ico"
            sizes="32x32"
        />
        <!-- Favicons adicionales para compatibilidad -->
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="https://mensajeriamedellin.com/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="https://mensajeriamedellin.com/favicon-16x16.png"
        />
        <!-- Apple Touch Icon -->
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="https://mensajeriamedellin.com/apple-touch-icon.png"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0066cc" />

        <!-- SEO -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImage} />

        <!-- Schema.org -->
        <slot name="schema" />
    </head>
    <body class="font-sans antialiased text-gray-800 bg-gray-50">
        <slot />
        <WhatsAppButton message={waMessage} buttonText={waButtonText} />
    </body>
</html>
