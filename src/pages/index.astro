---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import MobileMenu from "../components/MobileMenu.astro";
import { Image, getImage } from "astro:assets";
import serviceMoto from "../assets/images/service_moto.png";
import serviceDocs from "../assets/images/service_docs.png";
import serviceErrands from "../assets/images/service_errands.png";
import testimonio1 from "../assets/images/testimonio1.jpg";
import testimonio2 from "../assets/images/testimonio2.jpg";
import testimonio3 from "../assets/images/testimonio3.jpg";
import teamImage from "../assets/images/equipo-mensajeria.jpg";

const optimizedHeroBg = await getImage({ src: teamImage, format: "webp" });
const heroImageAbsoluteUrl = new URL(optimizedHeroBg.src, Astro.site);
const currentYear = new Date().getFullYear();
---

<Layout
	title="Mensajería Medellín | Envíos y Entregas Express en Moto"
	description="Servicio de mensajería en Medellín. Envío de documentos, paquetes y entregas express en moto. Cobertura en todo el Valle de Aburrá. Cotiza por WhatsApp."
	image={heroImageAbsoluteUrl.toString()}
	waMessage="Hola Mensajería Medellín, mi empresa necesita servicios de mensajería logística. ¿Me podrían dar más información?"
	waButtonText="Contacto Empresas"
>
	<script
		type="application/ld+json"
		slot="schema"
		set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CourierService",
			name: "Mensajería Medellín",
			url: "https://mensajeriamedellin.com/",
			logo: "https://mensajeriamedellin.com/logo.png",
			image: heroImageAbsoluteUrl.toString(),
			description:
				"Servicio de mensajería empresarial y domicilios para E-commerce en Medellín. Logística urbana rápida para tus envíos y documentos.",
			telephone: "+57 333 281 5872",
			areaServed: [
				{ "@type": "City", name: "Medellín" },
				{ "@type": "City", name: "Envigado" },
				{ "@type": "City", name: "Sabaneta" },
				{ "@type": "City", name: "Itagüí" },
				{ "@type": "City", name: "Bello" },
				{ "@type": "City", name: "La Estrella" },
			],
			priceRange: "$$",
		})}
	/>
	<header class="bg-white shadow-sm sticky top-0 z-50">
		<div
			class="container mx-auto px-4 py-4 flex justify-between items-center"
		>
			<a
				href="/"
				class="text-2xl font-bold text-brand-blue tracking-tight flex items-center gap-2"
			>
				<img
					src="/logo.png"
					alt="Logo Mensajería Medellín"
					class="h-10 w-10 object-contain"
				/>
				Mensajería Medellín
			</a>
			<nav class="hidden md:flex items-center gap-1">
				<a
					href="#servicios"
					class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium transition-colors"
					>Empresas</a
				>
				<a
					href="#servicios"
					class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium transition-colors"
					>E-commerce</a
				>
				<a
					href="#cobertura"
					class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium transition-colors"
					>Cobertura</a
				>
				<a
					href="#testimonios"
					class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium transition-colors"
					>Testimonios</a
				>
				<a
					href="#contacto"
					class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium transition-colors"
					>Contacto</a
				>
			</nav>
			<MobileMenu />
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section
			class="relative bg-brand-blue text-white py-12 lg:py-20 overflow-hidden"
		>
			<div class="container mx-auto px-4 relative z-10">
				<div
					class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
				>
					<!-- Text Content -->
					<div class="text-center lg:text-left order-2 lg:order-1">
						<div
							class="inline-block bg-blue-800/50 rounded-full px-4 py-1 mb-6 border border-blue-400/30 backdrop-blur-sm"
						>
							<span class="text-blue-100 font-medium text-sm"
								>🚀 Servicio Express en todo el Valle de Aburrá</span
							>
						</div>

						<h1
							class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight tracking-tight"
						>
							Logística urbana para <span
								class="text-brand-orange"
								>Empresas y E-commerce</span
							>
						</h1>

						<h2
							class="text-xl md:text-2xl font-medium mb-6 text-blue-100 leading-relaxed max-w-2xl mx-auto lg:mx-0"
						>
							Entregas el mismo día, rutas múltiples, recaudo
							contra entrega y facturación electrónica.
						</h2>

						<div
							class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
						>
							<a
								href="https://wa.me/573332815872?text=Hola+Mensajer%C3%ADa+Medell%C3%ADn%2C+vengo+de+su+p%C3%A1gina+web+y+necesito+cotizar+un+servicio."
								target="_blank"
								rel="noopener noreferrer"
								class="bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-8 rounded-full text-lg shadow-lg hover:shadow-xl hover:shadow-green-900/20 transition-all transform hover:-translate-y-1 inline-flex items-center justify-center gap-3 border-2 border-transparent"
								id="whatsapp-hero-btn"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-6 w-6"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
									></path>
								</svg>
								Cotizar despachos por WhatsApp
							</a>
						</div>

						<div
							class="mt-8 flex items-center justify-center lg:justify-start gap-4 text-sm text-blue-200"
						>
							<div class="flex items-center gap-1">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-5 w-5 text-green-400"
									viewBox="0 0 20 20"
									fill="currentColor"
								>
									<path
										fill-rule="evenodd"
										d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
										clip-rule="evenodd"></path>
								</svg>
								<span>Respuesta inmediata</span>
							</div>
							<div class="flex items-center gap-1">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									class="h-5 w-5 text-green-400"
									viewBox="0 0 20 20"
									fill="currentColor"
								>
									<path
										fill-rule="evenodd"
										d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
										clip-rule="evenodd"></path>
								</svg>
								<span>Pago contra entrega</span>
							</div>
						</div>
					</div>

					<!-- Image Content -->
					<div class="relative order-1 lg:order-2 mb-8 lg:mb-0">
						<div
							class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white/10 transform rotate-2 hover:rotate-0 transition-all duration-700 group"
						>
							<Image
								src={teamImage}
								alt="Equipo de mensajeros de Mensajería Medellín"
								class="w-full h-auto object-cover transform scale-105 group-hover:scale-100 transition-transform duration-700"
								loading="eager"
								fetchpriority="high"
								format="webp"
								width={800}
							/>
						</div>

						<!-- Badge Flotante -->
						<div
							class="absolute -bottom-5 right-2 md:-bottom-6 md:-right-4 bg-white text-gray-800 p-3 md:p-4 rounded-xl shadow-xl z-20 animate-bounce-slow"
						>
							<div class="flex items-center gap-3">
								<div class="bg-green-100 p-2 rounded-full">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="h-6 w-6 text-green-600"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
										></path>
									</svg>
								</div>
								<div>
									<p
										class="text-xs text-gray-500 font-semibold uppercase tracking-wider"
									>
										Calificación
									</p>
									<p class="text-lg font-bold">4.9/5.0 ⭐</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- How It Works Section -->
		<section class="py-12 md:py-20 bg-white border-b border-gray-100">
			<div class="container mx-auto px-4">
				<div class="text-center mb-10">
					<h2 class="text-3xl md:text-4xl font-bold text-gray-900">
						Solicita tu servicio en 3 pasos
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 relative">
					<!-- Step 1 -->
					<div
						class="flex flex-col items-center text-center relative z-10"
					>
						<div
							class="w-20 h-20 bg-brand-blue text-white rounded-full flex items-center justify-center text-3xl font-bold mb-6 shadow-lg shadow-blue-200"
						>
							1
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">
							Escríbenos
						</h3>
						<p class="text-gray-600 leading-relaxed">
							Toca el botón de WhatsApp y coordina tus rutas,
							entregas o distribución de productos.
						</p>
					</div>

					<!-- Arrow 1-2 (Desktop) -->
					<div
						class="hidden md:block absolute top-10 left-[28%] w-[10%] opacity-20"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
						</svg>
					</div>

					<!-- Step 2 -->
					<div
						class="flex flex-col items-center text-center relative z-10"
					>
						<div
							class="w-20 h-20 bg-brand-orange text-white rounded-full flex items-center justify-center text-3xl font-bold mb-6 shadow-lg shadow-orange-200"
						>
							2
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">
							Cotizamos
						</h3>
						<p class="text-gray-600 leading-relaxed">
							Te damos el valor exacto del servicio y tiempo
							estimado de llegada (sin sorpresas).
						</p>
					</div>

					<!-- Arrow 2-3 (Desktop) -->
					<div
						class="hidden md:block absolute top-10 right-[28%] w-[10%] opacity-20"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
						</svg>
					</div>

					<!-- Step 3 -->
					<div
						class="flex flex-col items-center text-center relative z-10"
					>
						<div
							class="w-20 h-20 bg-green-500 text-white rounded-full flex items-center justify-center text-3xl font-bold mb-6 shadow-lg shadow-green-200"
						>
							3
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">
							¡Listo!
						</h3>
						<p class="text-gray-600 leading-relaxed">
							Un mensajero experto se dirige a tu ubicación.
							Rastreo en tiempo real.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Services Grid -->
		<section id="servicios" class="py-12 md:py-20 bg-white">
			<div class="container mx-auto px-4">
				<div class="text-center mb-10">
					<h2
						class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
					>
						Nuestros Servicios
					</h2>
					<p class="text-xl text-gray-600 max-w-2xl mx-auto">
						Soluciones rápidas y efectivas para tus necesidades de
						transporte urbano.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Service Card 1 -->
					<div
						class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow border border-gray-100"
					>
						<div
							class="w-20 h-20 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 overflow-hidden p-3"
						>
							<Image
								src={serviceMoto}
								alt="Mensajero urbano en moto realizando entregas rápidas en Medellín"
								class="w-full h-full object-contain"
								width={200}
								format="webp"
							/>
						</div>
						<h3 class="text-2xl font-bold text-gray-900 mb-4">
							Entregas express para negocios
						</h3>
						<p class="text-gray-600 mb-4">
							Servicio express para envío de paquetes pequeños,
							documentos y mercancías ligeras. Llegamos a
							cualquier punto de Medellín en tiempo récord.
						</p>
					</div>

					<!-- Service Card 2 -->
					<div
						class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow border border-gray-100"
					>
						<div
							class="w-20 h-20 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 overflow-hidden p-3"
						>
							<Image
								src={serviceDocs}
								alt="Servicio de envíos de documentos y correspondencia empresarial"
								class="w-full h-full object-contain"
								width={200}
								format="webp"
							/>
						</div>
						<h3 class="text-2xl font-bold text-gray-900 mb-4">
							Envíos para Empresas
						</h3>
						<p class="text-gray-600 mb-4">
							Transporte seguro de facturas, contratos y
							correspondencia entre sedes. Logística eficiente
							para tu negocio.
						</p>
					</div>

					<!-- Service Card 3 -->
					<div
						class="bg-gray-50 rounded-xl p-8 hover:shadow-lg transition-shadow border border-gray-100"
					>
						<div
							class="w-20 h-20 bg-brand-blue/10 rounded-full flex items-center justify-center mb-6 overflow-hidden p-3"
						>
							<Image
								src={serviceMoto}
								alt="Entregas de paquetes para tiendas virtuales y e-commerce"
								class="w-full h-full object-contain"
								width={200}
								format="webp"
							/>
						</div>
						<h3 class="text-2xl font-bold text-gray-900 mb-4">
							Entregas para E-commerce
						</h3>
						<p class="text-gray-600 mb-4">
							Entregas para tiendas virtuales y emprendimientos.
							Llevamos tus productos a tus clientes con pago
							contra entrega.
						</p>
					</div>
				</div>

				<!-- Sección Diferenciada de Mandados -->
				<div class="text-center mt-12">
					<a
						href="https://wa.me/573332815872?text=Hola+Mensajer%C3%ADa+Medell%C3%ADn%2C+vengo+de+su+p%C3%A1gina+web+y+necesito+cotizar+un+servicio."
						target="_blank"
						rel="noopener noreferrer"
						class="bg-green-700 hover:bg-green-800 text-white font-bold py-4 px-8 rounded-full text-lg shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1 inline-flex items-center gap-2"
						id="whatsapp-services-btn"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-6 w-6"
							fill="currentColor"
							viewBox="0 0 24 24"
						>
							<path
								d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
							></path>
						</svg>
						🛵 Agendar Ruta (WhatsApp)
					</a>
				</div>
			</div>
		</section>

		<!-- Trust Section -->
		<section class="bg-gray-100 py-12">
			<div class="container mx-auto px-4">
				<div class="max-w-4xl mx-auto">
					<div
						class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
					>
						<div>
							<h2 class="text-3xl font-bold text-gray-900 mb-6">
								¿Por qué elegirnos?
							</h2>
							<ul class="space-y-4">
								<li class="flex items-start">
									<div
										class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-orange flex items-center justify-center mt-1 mr-3"
									>
										<svg
											class="w-4 h-4 text-white"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
											><path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M5 13l4 4L19 7"></path></svg
										>
									</div>
									<span class="text-lg text-gray-700"
										>Facturación electrónica</span
									>
								</li>
								<li class="flex items-start">
									<div
										class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-orange flex items-center justify-center mt-1 mr-3"
									>
										<svg
											class="w-4 h-4 text-white"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
											><path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M5 13l4 4L19 7"></path></svg
										>
									</div>
									<span class="text-lg text-gray-700"
										>Recaudo (contraentrega) + consignación</span
									>
								</li>
								<li class="flex items-start">
									<div
										class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-orange flex items-center justify-center mt-1 mr-3"
									>
										<svg
											class="w-4 h-4 text-white"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											xmlns="http://www.w3.org/2000/svg"
											><path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M5 13l4 4L19 7"></path></svg
