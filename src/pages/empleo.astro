---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import MobileMenu from "../components/MobileMenu.astro";
import { Image, getImage } from "astro:assets";
import teamImage from "../assets/images/equipo-mensajeria.jpg";

const optimizedTeamImage = await getImage({ src: teamImage, format: "webp" });
const heroImageAbsoluteUrl = new URL(optimizedTeamImage.src, Astro.site);
const currentYear = new Date().getFullYear();
---

<Layout
    title="Empleo Mensajero Medellín | Vacante Mensajero con Moto (A2)"
    description="Empleo mensajero Medellín. Vacante para mensajero motorizado con moto propia y licencia A2 en el Valle de Aburrá. Postúlate ahora por WhatsApp."
    image={heroImageAbsoluteUrl.toString()}
>
    <script
        type="application/ld+json"
        slot="schema"
        set:html={JSON.stringify([
            {
                "@context": "https://schema.org",
                "@type": "JobPosting",
                title: "Mensajero Motorizado",
                description:
                    "Buscamos mensajeros con moto propia para entregas y diligencias en Medellín y el Valle de Aburrá. Horarios flexibles, pagos semanales.",
                datePosted: new Date().toISOString().split("T")[0],
                validThrough: new Date(Date.now() + 90 * 24 * 60 * 60 * 1000)
                    .toISOString()
                    .split("T")[0],
                employmentType: "CONTRACTOR",
                hiringOrganization: {
                    "@type": "Organization",
                    name: "Mensajería Medellín",
                    sameAs: "https://mensajeriamedellin.com",
                },
                jobLocation: {
                    "@type": "Place",
                    address: {
                        "@type": "PostalAddress",
                        addressLocality: "Medellín",
                        addressRegion: "Antioquia",
                        addressCountry: "CO",
                    },
                },
            },
            {
                "@context": "https://schema.org",
                "@type": "FAQPage",
                mainEntity: [
                    {
                        "@type": "Question",
                        name: "¿Necesito moto propia para este empleo de mensajero en Medellín?",
                        acceptedAnswer: {
                            "@type": "Answer",
                            text: "Sí, es un requisito indispensable contar con motocicleta propia en buen estado y con toda la documentación al día (SOAT y Tecnicomecánica).",
                        },
                    },
                    {
                        "@type": "Question",
                        name: "¿La licencia A2 es obligatoria?",
                        acceptedAnswer: {
                            "@type": "Answer",
                            text: "Sí, para postularte a la vacante de mensajero motorizado debes contar con licencia de conducción categoría A2 vigente.",
                        },
                    },
                    {
                        "@type": "Question",
                        name: "¿En qué zonas trabajan?",
                        acceptedAnswer: {
                            "@type": "Answer",
                            text: "Operamos en todo Medellín y el Valle de Aburrá, incluyendo Envigado, Sabaneta, Itagüí, La Estrella y Bello.",
                        },
                    },
                    {
                        "@type": "Question",
                        name: "¿Cómo es el proceso para postularme?",
                        acceptedAnswer: {
                            "@type": "Answer",
                            text: "El proceso es simple: haz clic en el botón de WhatsApp, envíanos tus datos básicos y nosotros nos pondremos en contacto contigo para una entrevista.",
                        },
                    },
                ],
            },
        ])}
    />
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div
            class="container mx-auto px-4 py-4 flex justify-between items-center"
        >
            <a
                href="/"
                class="text-2xl font-bold text-brand-blue tracking-tight flex items-center gap-2"
            >
                <img
                    src="/logo.png"
                    alt="Logo Mensajería Medellín"
                    class="h-10 w-10 object-contain"
                />
                Mensajería Medellín
            </a>
            <nav class="hidden md:flex items-center gap-1">
                <a
                    href="/"
                    class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium"
                    >Inicio</a
                >
                <a
                    href="/mandados"
                    class="text-gray-600 hover:text-brand-blue px-3 py-2 font-medium"
                    >Mandados</a
                >
                <a
                    href="/empleo"
                    class="text-brand-blue px-3 py-2 font-medium border-b-2 border-brand-blue"
                    >Empleo</a
                >
            </nav>
            <MobileMenu />
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section
            class="relative bg-brand-blue text-white py-12 lg:py-20 overflow-hidden"
        >
            <div class="container mx-auto px-4 relative z-10">
                <div
                    class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16"
                >
                    <!-- Text Column -->
                    <div class="flex-1 text-center lg:text-left">
                        <span
                            class="inline-block bg-white/20 text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-4"
                        >
                            💼 Oportunidad de Empleo
                        </span>
                        <h1
                            class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-4 leading-tight"
                        >
                            Empleo mensajero Medellín (mensajero con moto)
                        </h1>
                        <p
                            class="text-xl md:text-2xl text-white/90 mb-8 max-w-xl mx-auto lg:mx-0"
                        >
                            Vacante para mensajero motorizado en Medellín y el
                            Valle de Aburrá. Si tienes moto propia y licencia
                            A2, postúlate y te contactamos por WhatsApp.
                        </p>
                        <div
                            class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
                        >
                            <a
                                href="https://wa.me/573332815872?text=Hola%2C%20quiero%20postularme%20a%20la%20vacante%20de%20mensajero%20en%20Medell%C3%ADn"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="bg-brand-orange text-white px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all flex items-center justify-center gap-2"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-6 w-6"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M17.472 14.382c-.297-.148-1.758-.867-2.03-.967-.272-.099-.47-.148-.67.15-.197.296-.767.966-.94 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.074-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.064 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.861 9.861 0 01-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.892 6.993c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.546 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                    ></path>
                                </svg>
                                Postularme a la vacante
                            </a>
                            <a
                                href="#requisitos"
                                class="bg-white/10 hover:bg-white/20 text-white px-8 py-4 rounded-full font-bold text-lg backdrop-blur-sm transition-all flex items-center justify-center border border-white/30"
                            >
                                Ver requisitos
                            </a>
                        </div>
                    </div>

                    <!-- Image Column -->
                    <div class="flex-1 relative hidden lg:block">
                        <div
                            class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white/20"
                        >
                            <Image
                                src={teamImage}
                                alt="Equipo de mensajeros de Mensajería Medellín"
                                class="w-full h-auto object-cover"
                                width={600}
                                format="webp"
                                quality="high"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Vacante Details Block -->
        <section class="bg-gray-50 py-10 border-b border-gray-100">
            <div class="container mx-auto px-4">
                <div
                    class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 text-center"
                >
                    <div class="p-3">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Cargo</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >Mensajero motorizado</span
                        >
                    </div>
                    <div class="p-3 border-l border-gray-200">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Ubicación</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >Medellín + Valle de Aburrá</span
                        >
                    </div>
                    <div class="p-3 border-l border-gray-200">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Licencia</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >Categoría A2</span
                        >
                    </div>
                    <div class="p-3 border-l border-gray-200">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Vehículo</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >Moto propia</span
                        >
                    </div>
                    <div class="p-3 border-l border-gray-200">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Entrada</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >Inmediata</span
                        >
                    </div>
                    <div class="p-3 border-l border-gray-200">
                        <span
                            class="block text-xs uppercase tracking-wider text-gray-500 font-bold mb-1"
                            >Aplicación</span
                        >
                        <span class="text-sm font-bold text-brand-blue"
                            >WhatsApp</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Requisitos -->
        <section id="requisitos" class="bg-white py-12 md:py-20">
            <div class="container mx-auto px-4">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        ¿Qué necesitas para aplicar?
                    </h2>
                    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                        Requisitos básicos para unirte a nuestro equipo.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"
                >
                    <!-- Requisito 1 -->
                    <div
                        class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center"
                    >
                        <div
                            class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8 text-brand-blue"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Licencia A2
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Licencia de conducción vigente para motocicleta.
                        </p>
                    </div>

                    <!-- Requisito 2 -->
                    <div
                        class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center"
                    >
                        <div
                            class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8 text-brand-blue"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Moto Propia
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Motocicleta en buen estado con documentos al día.
                        </p>
                    </div>

                    <!-- Requisito 3 -->
                    <div
                        class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center"
                    >
                        <div
                            class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8 text-brand-blue"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Smartphone
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Celular con WhatsApp y datos móviles.
                        </p>
                    </div>

                    <!-- Requisito 4 -->
                    <div
                        class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center"
                    >
                        <div
                            class="w-16 h-16 bg-brand-blue/10 rounded-full flex items-center justify-center mx-auto mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8 text-brand-blue"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Conocer Medellín
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Saber moverse por la ciudad y el área metropolitana.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Beneficios -->
        <section class="bg-gray-50 py-12 md:py-20">
            <div class="container mx-auto px-4">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        ¿Qué ofrecemos como empleo de mensajero en Medellín?
                    </h2>
                    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                        Beneficios de trabajar con nuestro equipo logístico.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto"
                >
                    <!-- Beneficio 1 -->
                    <div
                        class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm"
                    >
                        <div class="text-3xl mb-3">💰</div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Pagos Puntuales
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Pagos semanales realizados sin demoras por los
                            servicios completados con éxito.
                        </p>
                    </div>

                    <!-- Beneficio 2 -->
                    <div
                        class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm"
                    >
                        <div class="text-3xl mb-3">⏰</div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Turnos o Flexibilidad
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Tú eliges tus horarios según disponibilidad. Ideal
                            para tiempo completo o turnos parciales.
                        </p>
                    </div>

                    <!-- Beneficio 3 -->
                    <div
                        class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm"
                    >
                        <div class="text-3xl mb-3">📍</div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Operación Local
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Servicios en Medellín, Envigado, Sabaneta e Itagüí
                            para optimizar tus recorridos.
                        </p>
                    </div>

                    <!-- Beneficio 4 -->
                    <div
                        class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm"
                    >
                        <div class="text-3xl mb-3">💬</div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2">
                            Acompañamiento
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Coordinación constante por WhatsApp para apoyarte en
                            cada servicio y trámite.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Funciones Section -->
        <section class="bg-white py-12 md:py-20 border-t border-gray-100">
            <div class="container mx-auto px-4">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-gray-900 mb-4"
                    >
                        ¿Qué hace un mensajero motorizado con nosotros?
                    </h2>
                    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                        Estas son las principales labores que realizarás en tu
                        día a día.
                    </p>
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto font-medium"
                >
                    <div
                        class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg"
                    >
                        <span class="text-brand-orange">✓</span> Diligencias y mandados
                        personales
                    </div>
                    <div
                        class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg"
                    >
                        <span class="text-brand-orange">✓</span> Compras (droguería,
                        super, ferretería)
                    </div>
                    <div
                        class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg"
                    >
                        <span class="text-brand-orange">✓</span> Radicación y trámites
                        legales
                    </div>
                    <div
                        class="flex items-center gap-3 p-4 bg-gray-50 rounded-lg"
                    >
                        <span class="text-brand-orange">✓</span> Entregas y recogidas
                        punto a punto
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="bg-gray-50 py-12 md:py-20 border-t border-gray-100">
            <div class="container mx-auto px-4">
                <div class="max-w-3xl mx-auto">
                    <h2
                        class="text-3xl font-bold text-center text-gray-900 mb-12"
                    >
                        Preguntas frecuentes sobre el empleo
                    </h2>

                    <div class="space-y-8">
                        <div>
                            <h3 class="text-xl font-bold text-brand-blue mb-3">
                                ¿Necesito moto propia para este empleo de
                                mensajero en Medellín?
                            </h3>
                            <p class="text-gray-600">
                                Sí, es un requisito indispensable. Debes contar
                                con motocicleta propia en buen estado y con toda
                                la documentación al día (SOAT y
                                Tecnicomecánica).
                            </p>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-brand-blue mb-3">
                                ¿La licencia A2 es obligatoria?
                            </h3>
                            <p class="text-gray-600">
                                Sí, para postularte debes contar con licencia de
                                conducción categoría A2 vigente y sin multas
                                pendientes (o con acuerdo de pago).
                            </p>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-brand-blue mb-3">
                                ¿Cuánto dinero se puede generar?
                            </h3>
                            <p class="text-gray-600">
                                Los ingresos dependen del volumen de servicios
                                realizados y el tiempo que dediques. Realizamos
                                pagos semanales basados en tu productividad.
                            </p>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-brand-blue mb-3">
                                ¿Cómo es el proceso de postulación?
                            </h3>
                            <p class="text-gray-600">
                                Haz clic en el botón de WhatsApp, envíanos tu
                                nombre y menciona que tienes moto y licencia A2.
                                Te contactaremos para una entrevista breve.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Final -->
        <section class="bg-brand-blue py-12">
            <div class="container mx-auto px-4 text-center">
                <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
                    ¿Listo para empezar?
                </h2>
                <p class="text-white/80 mb-6 max-w-xl mx-auto">
                    Escríbenos por WhatsApp con tus datos y te contactamos.
                </p>
                <a
                    href="https://wa.me/573332815872?text=Hola%2C%20quiero%20trabajar%20como%20mensajero.%20Mi%20nombre%20es%3A"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 bg-white text-brand-blue px-8 py-4 rounded-full font-bold text-lg shadow-lg hover:shadow-xl hover:scale-105 transition-all"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
